	Work{
		From:        "Jun 2024",
		To:          "present",
		Company:     "Freelance",
		Role:        "Developer",
		Description: "Fullstack developer working on varios projects related to web and mobile applications.",
		Tags:        []string{},
	},
	Work{
		From:        "Apr 2017",
		To:          "Jun 2024",
		Company:     "Brandpad",
		Role:        "Frontend lead",
