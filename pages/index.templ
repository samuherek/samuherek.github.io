package pages

import (
	"samuherek/layout"
)

type Work struct {
	From        string
	To          string
	Company     string
	Role        string
	Description string
	Tags        []string
}

var work = []Work{
	Work{
		From:        "Jun 2024",
		To:          "present",
		Company:     "Freelance",
		Role:        "Developer",
		Description: "Taking on smaller projects of verios types to split the time between side project and income.",
		Tags:        []string{"Typescript"},
	},
	Work{
		From:        "Apr 2017",
		To:          "Jun 2024",
		Company:     "Brandpad",
		Role:        "Frontend lead",
		Description: "Main lead on a website builder for brand designers. From the start of the project till the full majority I worked on every part of the frontend. In addition, I managed the development lifecycle and the QA.",
		Tags:        []string{"Typescript", "React"},
	},
	Work{
		From:        "Aug 2018",
		To:          "Dec 2019",
		Company:     "Nexoya",
		Role:        "Frontend developer",
		Description: "From a prototype to a fully redesigned application based on UI/UX designes. As the only frontend developer on the team, I coverd all the aspects of the building and delivery process. The application required custom d3 graphs for marketing analysis.",
		Tags:        []string{"Typescript", "React"},
	},
	Work{
		From:        "Aug 2015",
		To:          "Apr 2017",
		Company:     "Freelance",
		Role:        "Frontend developer",
		Description: "Various projects like rebrending Hashdocs, product inventory dashboard and marketing websites translating UI mockups into live websites.",
		Tags:        []string{"Javascript", "React", "CSS"},
	},
	Work{
		From:        "Sept 2014",
		To:          "Aug 2015",
		Company:     "Vicancy",
		Role:        "UI/UX designer",
		Description: "Main UI and UX designer for a starup focused on creating short marketing videos. Primary job was to map out the flows and design the UI for the product and marketing website.",
		Tags:        []string{},
	},
	Work{
		From:        "Sept 2012",
		To:          "Sept 2014",
		Company:     "Freelance",
		Role:        "UI/UX designer",
		Description: "Various projects like membership websites, marketing websites and mobile applications.",
		Tags:        []string{},
	},
}

type Project struct {
	Name        string
	Description string
	Github      string
	Website     string
	Tags        []string
}

var projects = []Project{
	Project{
		Name:        "pimp",
		Description: "Practice makes perfect. P[i]mp your fluency in everyday coding skills. Mobile and cli application for practicing your skills of clis, packages, and less used language sytax.",
		Github:      "",
		Website:     "https://pimpcode.app",
		Tags:        []string{"Rust", "Go", "Htmx", "Flutter"},
	},
	Project{
		Name:        "dripin",
		Description: "Pin directory or project data which synchronizes across devices through encryted server. Helper tool to keep notes, links, commands to learn for specific prject at hand.",
		Github:      "https://github.com/samuherek/dirpin",
		Website:     "",
		Tags:        []string{"Rust", "Ratatui"},
	},
	Project{
		Name:        "ExiMd",
		Description: "Quick exif media medic for your media files. The main purpose is renaming media files along their related files (live photo, edit files, ...) so that you keep everything together as well as deduplicating the files.",
		Github:      "https://github.com/samuherek/eximd",
		Website:     "",
		Tags:        []string{"Rust", "Tauri"},
	},
	Project{
		Name:        "backup-codepen-cli",
		Description: "Cli tool to backup your codepen work to store locally in case something goes wrong with codepen.",
		Github:      "https://github.com/samuherek/backup-codepen-cli",
		Website:     "",
		Tags:        []string{"Typescript"},
	},
	Project{
		Name:        "Splitshare",
		Description: "Simple app for splitting bills between friends, family and partners (not budgeting). Proof of concenpt",
		Github:      "https://github.com/samuherek/splitshare",
		Website:     "",
		Tags:        []string{"Typescript"},
	},
}

templ Home() {
	<header class="flex items-center justify-between h-11 px-4">
		<div></div>
		<ul class="flex">
			<li class="pr-8">
				<span>About</span>
			</li>
			<li>
				<button id="switch" class="uk-btn uk-btn-text">
					<svg id="dark-switch" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon">
						<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
					</svg>
					<svg id="light-switch" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2"></path>
						<path d="M12 20v2"></path>
						<path d="m4.93 4.93 1.41 1.41"></path>
						<path d="m17.66 17.66 1.41 1.41"></path>
						<path d="M2 12h2"></path>
						<path d="M20 12h2"></path>
						<path d="m6.34 17.66-1.41 1.41"></path>
						<path d="m19.07 4.93-1.41 1.41"></path>
					</svg>
				</button>
			</li>
		</ul>
	</header>
	<div class="flex justify-center items-center">
		<div class="pt-36 md:w-1/2">
			<div class="flex flex-col mb-8">
				<h1 class="uk-hero-lg mb-12 font-medium">
					<span
						id="dark-name"
					>
						<span
							class="uk-text-background w-52 md:w-auto"
							style="background-image: linear-gradient(90deg, #e4e405 0%, #f01ebb 100%)"
						>
							Sam Uherek
						</span>
					</span>
					<span
						id="light-name"
						class="hidden"
					>
						<span
							class="uk-text-background w-52 md:w-auto"
							style="background-image: linear-gradient(90deg, #000000 0%, #f01ebb 100%)"
						>
							Sam Uherek
						</span>
					</span>
				</h1>
				<p class="text-xl font-medium dark:font-normal text-black dark:text-neutral-500 mb-4">
					Hi there!
				</p>
				<p class="text-lg text-neutral-800 dark:text-neutral-300 mb-12 md:mb-8">
					A software enthusiast who enjoys learning and building things here. 
				</p>
				<p class="text-xl font-medium dark:font-normal text-black dark:text-neutral-500 mb-4">
					In a nutshell:
				</p>
				<p class="text-lg text-neutral-800 dark:text-neutral-300 mb-12 md:mb-8">
					Most of my professional experience is building frontend applications from simple apps to complex website builders. However, recently found joy in 
					building cli applications and other tools used behind the scene of a business. 
					Before getting into coding, I worked as a UI/UX designer mapping out user flows and making apps look better.
					On the side, I've always explored various projects mostly to solve my own problems. 
				</p>
				<p class="text-xl font-medium dark:font-normal text-black dark:text-neutral-500 mb-4">
					Get in touch:
				</p>
				<ul class="flex space-x-4 mb-48 text-neutral-600 dark:text-neutral-50">
					<li>
						<a target="_blank" href="https://github.com/samuherek">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github">
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
								<path d="M9 18c-4.51 2-5-2-7-2"></path>
							</svg>
						</a>
					</li>
					<li>
						<a target="_blank" href="https://codepen.io/samuherek">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-codepen">
								<polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon>
								<line x1="12" x2="12" y1="22" y2="15.5"></line>
								<polyline points="22 8.5 12 15.5 2 8.5"></polyline>
								<polyline points="2 15.5 12 8.5 22 15.5"></polyline>
								<line x1="12" x2="12" y1="2" y2="8.5"></line>
							</svg>
						</a>
					</li>
					<li>
						<a target="_blank" href="https://dribbble.com/SamuelUherek">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dribbble">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M19.13 5.09C15.22 9.14 10 10.44 2.25 10.94"></path>
								<path d="M21.75 12.84c-6.62-1.41-12.14 1-16.38 6.32"></path>
								<path d="M8.56 2.75c4.37 6 6 9.42 8 17.72"></path>
							</svg>
						</a>
					</li>
					<li>
						<a target="_blank" href="https://www.linkedin.com/in/samuel-uherek-69662216/">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin">
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
								<rect width="4" height="12" x="2" y="9"></rect>
								<circle cx="4" cy="4" r="2"></circle>
							</svg>
						</a>
					</li>
					<li>
						<a target="_blank" href="mailto:hey@samuherek.com" class="uk-btn uk-btn-text">
							hey@samuherek.com
						</a>
					</li>
				</ul>
				<h1 class="uk-hero-sm uk-heading-line uk-text-left mb-12">
					<span>Work history</span>
				</h1>
				<div class="relative before:absolute before:content-[' '] before:w-[2px] before:top-[10px] before:bottom-[52px] before:left-[4px]  before:bg-neutral-100 dark:before:bg-neutral-800 mb-12">
					for _, item := range work {
						<div class="mb-12 relative pl-5 md:pl-8">
							<div class="before:content-['+'] before:absolute before:left-0">
								<p class="mb-6">
									<span class="text-neutral-100 dark:text-neutral-500 bg-neutral-900 dark:bg-neutral-50 px-1 py-0.5">{ item.From } - { item.To }</span>
								</p>
								<h3 class="text-lg mb-2">
									<span class="underline underline-offset-4 font-medium dark:font-normal">{ item.Company }</span> <span class="text-neutral-400 dark:text-neutral-500 pl-2">{ item.Role }</span>
								</h3>
							</div>
							<p class="text-neutral-800 dark:text-neutral-300">
								{ item.Description }
							</p>
							if len(item.Tags) > 0 {
								<ul class="flex space-x-4 pt-4">
									for _, tag := range item.Tags {
										<li class="text-neutral-400 dark:text-neutral-500">
											{ tag }
										</li>
									}
								</ul>
							}
						</div>
					}
				</div>
				<h1 class="uk-hero-sm uk-heading-line uk-text-left mb-12">
					<span>Side projects</span>
				</h1>
				<div class="mb-12">
					for _, item := range projects {
						<div class="mb-12">
							<div class="flex justify-between items-center mb-2">
								<h3 class="text-lg pr-4">
									<span class="font-medium dark:font-normal">{ item.Name }</span>
								</h3>
								<ul class="flex space-x-4">
									if len(item.Github) > 0 {
										<li>
											<a target="_blank" href={ templ.URL(item.Github) } class="uk-btn uk-btn-text">
												<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github">
													<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
													<path d="M9 18c-4.51 2-5-2-7-2"></path>
												</svg>
											</a>
										</li>
									}
									if len(item.Website) > 0 {
										<li>
											<a target="_blank" href={ templ.URL(item.Website) } class="uk-btn uk-btn-text">
												<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link">
													<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
													<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
												</svg>
											</a>
										</li>
									}
								</ul>
							</div>
							<p class="text-neutral-800 dark:text-neutral-300 mb-4">
								{ item.Description }
							</p>
							<ul class="flex space-x-4">
								for _, tag := range item.Tags {
									<li class="text-neutral-400 dark:text-neutral-500">
										{ tag }
									</li>
								}
							</ul>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ HomeWrapper(
	title string,
	cmp templ.Component,
) {
	@layout.Base(title) {
		@cmp
	}
}
