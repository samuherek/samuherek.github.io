package pages

import (
	"samuherek/layout"
)

type Work struct {
	From        string
	To          string
	Company     string
	Role        string
	Description string
}

var work = []Work{
	Work{
		From:        "Jun 2024",
		To:          "present",
		Company:     "Freelance",
		Role:        "Fullstack developer",
		Description: "Fullstack developer working on varios projects related to web and mobile applications.",
	},
	Work{
		From:        "Apr 2017",
		To:          "Jun 2024",
		Company:     "Brandpad",
		Role:        "Frontend lead",
		Description: "Main lead on the website builder for brand designers. From the start of the project till the full majority I worked on every part of the frontend part of the application.",
	},
	Work{
		From:        "Aug 2018",
		To:          "Dec 2019",
		Company:     "Nexoya",
		Role:        "Frontend developer",
		Description: "From prototype of an idea to a fully redesigned application based on UI/UX designes. As the only frontend developer on the team, I coverd all the aspects of the building and delivery process.",
	},
	Work{
		From:        "Aug 2015",
		To:          "Apr 2017",
		Company:     "Freelance",
		Role:        "Frontend developer",
		Description: "From prototype of an idea to a fully redesigned application based on UI/UX designes. As the only frontend developer on the team, I coverd all the aspects of the building and delivery process.",
	},
	Work{
		From:        "Sept 2014",
		To:          "Aug 2015",
		Company:     "Vicancy",
		Role:        "UI/UX designer",
		Description: "From prototype of an idea to a fully redesigned application based on UI/UX designes. As the only frontend developer on the team, I coverd all the aspects of the building and delivery process.",
	},
	Work{
		From:        "Sept 2012",
		To:          "Sept 2014",
		Company:     "Freelance",
		Role:        "UI/UX designer",
		Description: "From prototype of an idea to a fully redesigned application based on UI/UX designes. As the only frontend developer on the team, I coverd all the aspects of the building and delivery process.",
	},
}

templ Home() {
	<header class="flex items-center justify-between h-11 px-4">
		<div></div>
		<ul class="flex">
			<li class="pr-8">
				<a href="#" class="uk-btn uk-btn-text">About</a>
			</li>
			<li>
				<a href="#" class="uk-btn uk-btn-text opacity-50 hover:opacity-100">Projects</a>
			</li>
		</ul>
	</header>
	<div class="flex justify-center items-center">
		<div class="pt-36 md:w-1/2">
			<div class="flex flex-col mb-8">
				<h1 class="uk-hero-lg mb-12 font-medium">
					<span
						class="text-yellow-500 uk-text-background w-52 md:w-auto"
						style="background-image: linear-gradient(90deg, #e4e405 0%, #f01ebb 100%)"
					>
						Sam Uherek
					</span>
				</h1>
				<p class="text-xl text-neutral-500 mb-4">
					Hi there!
				</p>
				<p class="text-lg text-neutral-300 mb-12 md:mb-8">
					A software enthusiast who enjoys learning and building things here. 
				</p>
				<p class="text-xl text-neutral-500 mb-4">
					In a nutshell:
				</p>
				<p class="text-lg text-neutral-300 mb-12 md:mb-8">
					Worked as a frontend developer for the last 8 years with a found passion for building internal tools like cli apps.
					Before getting into coding, I worked as a UI/UX designer and you can see some of the old work <a href="#" class="uk-btn uk-btn-text">here</a>.
					On the side, I've explored various <a href="/projects" class="uk-btn uk-btn-text">projects</a> mostly to solve my own problems. 
				</p>
				<p class="text-xl text-neutral-500 mb-4">
					Get in touch:
				</p>
				<ul class="flex space-x-4 mb-48">
					<li>
						<a href="#">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github">
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
								<path d="M9 18c-4.51 2-5-2-7-2"></path>
							</svg>
						</a>
					</li>
					<li>
						<a href="#">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin">
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
								<rect width="4" height="12" x="2" y="9"></rect>
								<circle cx="4" cy="4" r="2"></circle>
							</svg>
						</a>
					</li>
					<li>
						<a href="mailto:hey@samuherek.com" class="uk-btn uk-btn-text">
							hey@samuherek.com
						</a>
					</li>
				</ul>
				<h1 class="uk-hero-sm uk-heading-line uk-text-left mb-12">
					<span>Work history</span>
				</h1>
				<div class="relative before:absolute before:content-[' '] before:w-[2px] before:top-[10px] before:bottom-0 before:left-[4px] before:bg-neutral-800">
					for _, item := range work {
						<div class="mb-12 relative pl-5 md:pl-8">
							<div class="before:content-['+'] before:absolute before:left-0">
								<p class="mb-6">
									<span class="text-neutral-500 bg-neutral-50 px-1 py-0.5">{ item.From } - { item.To }</span>
								</p>
								<h3 class="text-lg">
									{ item.Company } <span class="text-neutral-500 pl-2">{ item.Role }</span>
								</h3>
							</div>
							<p class="text-neutral-300">
								{ item.Description }
							</p>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ HomeWrapper(
	title string,
	cmp templ.Component,
) {
	@layout.Base(title) {
		@cmp
	}
}
